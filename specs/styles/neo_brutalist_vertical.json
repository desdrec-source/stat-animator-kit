{
  "data_file": "../example_data.json",
  "theme": "neo_brutalist",
  "canvas": {"width": 1080, "height": 1920, "fps": 30, "hold": 2.0},
  "elements": [
    {"id": "title_card", "type": "panel", "x": 70, "y": 90, "w": 928, "h": 330, "fill": "accent", "start": 0.0},
    {"id": "title", "type": "text", "role": "headline", "text": "$title", "size": 112,
     "x": 112, "y": 228, "anchor": "ls", "wrap_width": 850, "max_lines": 2, "balance": true, "start": 0.0},
    {"id": "subtitle", "type": "text", "role": "body", "text": "$subtitle", "size": 36,
     "x": 70, "y": 500, "anchor": "ls", "wrap_width": 930, "balance": true, "start": 0.35, "enter": "fade", "enter_dur": 0.3},

    {"id": "hero_card", "type": "panel", "x": 70, "y": 610, "w": 928, "h": 580, "fill": "surface", "start": 0.7},
    {"id": "hero_tag_box", "type": "panel", "x": 110, "y": 646, "w": 330, "h": 64, "fill": "accent3", "radius": 6,
     "border": 4, "shadow": false, "start": 0.85, "enter": "pop", "enter_scale": 0.6},
    {"id": "hero_tag", "type": "text", "role": "label", "text": "$donut_label", "size": 32,
     "x": 275, "y": 690, "anchor": "ms", "max_width": 300, "start": 0.85, "enter": "pop", "enter_scale": 0.6, "allow_overlap": true},
    {"id": "hero_num", "type": "line", "x": 104, "y": 930, "font": "number", "size": 240, "color": "text",
     "runs": [{"value": "$donut_pct", "decimals": 1, "suffix": "%", "sync": "hero_bar", "seg": 0}],
     "start": 1.0, "enter": "fade", "enter_dur": 0.15},
    {"id": "hero_bar", "type": "bar", "x": 110, "y": 975, "w": 848, "h": 64, "border": 5, "gap": 5, "gap_color": "border",
     "track": "bg", "ease": "steps(6)", "track_dur": 0.1,
     "segments": [{"value": "$using_pct", "color": "accent3"}, {"value": "$notusing_pct", "color": "accent2"}],
     "start": 1.0, "dur": 1.5},
    {"id": "using_row", "type": "line", "x": 110, "y": 1105, "font": "body_bold", "size": 38, "color": "text",
     "runs": [{"swatch": "accent3", "size": 30, "gap": 16, "border": 3, "radius": 0}, {"text": "${using_label}  "},
              {"value": "$using", "sync": "hero_bar", "seg": 0}, {"text": " ("},
              {"value": "$using_pct", "decimals": 1, "suffix": "%", "sync": "hero_bar", "seg": 0}, {"text": ")"}],
     "start": 1.0, "enter": "fade", "enter_dur": 0.15},
    {"id": "notusing_row", "type": "line", "x": 110, "y": 1160, "font": "body_bold", "size": 38, "color": "text",
     "runs": [{"swatch": "accent2", "size": 30, "gap": 16, "border": 3, "radius": 0}, {"text": "${notusing_label}  "},
              {"value": "$notusing", "sync": "hero_bar", "seg": 1}, {"text": " ("},
              {"value": "$notusing_pct", "decimals": 1, "suffix": "%", "sync": "hero_bar", "seg": 1}, {"text": ")"}],
     "start": 1.0, "enter": "fade", "enter_dur": 0.15},

    {"id": "fleet_card", "type": "panel", "x": 70, "y": 1245, "w": 928, "h": 330, "fill": "surface", "start": 2.6},
    {"id": "capable", "type": "line", "x": 110, "y": 1318, "font": "body_bold", "size": 44, "color": "text",
     "runs": [{"text": "${capable_label}  "}, {"value": "$capable"}], "start": 2.75, "dur": 0.8, "enter": "fade", "enter_dur": 0.15},
    {"id": "fleet_line", "type": "line", "x": 110, "y": 1372, "font": "body", "size": 32, "color": "muted",
     "runs": [{"text": "$fleet_prefix"}, {"value": "$fleet"}, {"text": "$fleet_suffix"}],
     "start": 2.9, "dur": 0.8, "enter": "fade", "enter_dur": 0.15},
    {"id": "bar", "type": "bar", "x": 110, "y": 1405, "w": 848, "h": 72, "border": 5, "gap": 5, "gap_color": "border",
     "track": "bg", "ease": "steps(6)", "track_dur": 0.1,
     "segments": [{"value": "$bar_using", "color": "accent3"}, {"value": "$bar_notusing", "color": "accent2"},
                  {"value": "$bar_notcapable", "color": "notcap"}],
     "start": 3.3, "dur": 1.5},
    {"id": "bar_legend", "type": "line", "x": 110, "y": 1532, "font": "body_bold", "size": 27, "color": "text",
     "runs": [{"text": "$bar_using_label"}, {"value": "$bar_using", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 0},
              {"text": "  /  ${bar_notusing_label}"}, {"value": "$bar_notusing", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 1},
              {"text": "  /  ${bar_notcapable_label}"}, {"value": "$bar_notcapable", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 2}],
     "start": 3.3, "enter": "fade", "enter_dur": 0.15},

    {"id": "dist_card", "type": "panel", "x": 70, "y": 1630, "w": 928, "h": 110, "fill": "accent2", "start": 4.9},
    {"id": "distance", "type": "line", "x": 534, "y": 1700, "align": "center", "font": "body_bold", "size": 40, "color": "surface",
     "runs": [{"text": "$distance_label"}, {"value": "$distance"}, {"text": "$distance_unit"}],
     "start": 4.9, "dur": 1.0},

    {"id": "source", "type": "text", "role": "source", "text": "$source",
     "x": 70, "y": 1800, "anchor": "ls", "wrap_width": 940, "break_at": " · ", "start": 6.0, "enter": "fade", "enter_dur": 0.3},
    {"id": "credit", "type": "text", "role": "source", "text": "$credit",
     "x": 1010, "y": 1886, "anchor": "rs", "start": 6.1, "enter": "fade", "enter_dur": 0.3}
  ]
}
