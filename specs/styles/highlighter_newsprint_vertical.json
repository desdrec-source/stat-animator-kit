{
  "data_file": "../example_data.json",
  "theme": "highlighter_newsprint",
  "canvas": {"width": 1080, "height": 1920, "fps": 30, "hold": 2.5},
  "elements": [
    {"id": "rule_top", "type": "rule", "x0": 80, "x1": 1000, "y0": 112, "width": 4, "color": "text", "start": 0.0, "draw_dur": 0.5},
    {"id": "rule_top2", "type": "rule", "x0": 80, "x1": 1000, "y0": 124, "width": 1, "color": "text", "start": 0.1, "draw_dur": 0.5},
    {"id": "title", "type": "text", "role": "headline", "text": "$title", "size": 104,
     "x": 540, "y": 250, "anchor": "ms", "wrap_width": 920, "max_lines": 2, "balance": true, "start": 0.2},
    {"id": "subtitle", "type": "text", "role": "body", "text": "$subtitle", "size": 40,
     "x": 540, "y": 450, "anchor": "ms", "wrap_width": 900, "balance": true, "start": 0.6},
    {"id": "rule_mid", "type": "rule", "x0": 380, "x1": 700, "y0": 548, "width": 2, "color": "text", "start": 0.9, "draw_dur": 0.4},

    {"id": "hero_hl", "type": "highlight", "target": "hero", "pad": [30, 4], "start": 1.6, "dur": 0.5, "seed": 4},
    {"id": "hero", "type": "line", "x": 540, "y": 815, "align": "center", "font": "headline", "size": 250, "color": "text",
     "count_mode": "none", "tabular": "off", "runs": [{"value": "$donut_pct", "decimals": 1, "suffix": "%"}], "start": 1.0},
    {"id": "hero_label", "type": "text", "role": "label", "text": "$donut_label", "size": 40,
     "x": 540, "y": 900, "anchor": "ms", "start": 1.3},

    {"id": "clip", "type": "panel", "x": 100, "y": 975, "w": 880, "h": 330, "fill": "surface", "border": 0, "start": 2.2},
    {"id": "cap_row", "type": "line", "x": 540, "y": 1062, "align": "center", "font": "body", "size": 38, "color": "text",
     "runs": [{"text": "${capable_label}  "}, {"value": "$capable", "font": "kinetic", "size": 64}], "start": 2.4, "dur": 1.0},
    {"id": "using_lbl", "type": "text", "text": "$using_label", "font": "body", "size": 38, "color": "text",
     "x": 455, "y": 1160, "anchor": "rs", "start": 2.7},
    {"id": "using_val", "type": "line", "x": 520, "y": 1160, "font": "kinetic", "size": 64, "color": "text",
     "runs": [{"value": "$using"}, {"text": "   ("}, {"value": "$using_pct", "decimals": 1, "suffix": "%"}, {"text": ")"}],
     "start": 2.7, "dur": 1.0},
    {"id": "using_mark", "type": "marker", "target": "using_val#0", "start": 3.9, "dur": 0.6, "pad": [12, 10]},
    {"id": "notusing_lbl", "type": "text", "text": "$notusing_label", "font": "body", "size": 38, "color": "muted",
     "x": 455, "y": 1258, "anchor": "rs", "start": 3.0},
    {"id": "notusing_val", "type": "line", "x": 520, "y": 1258, "font": "kinetic", "size": 64, "color": "muted",
     "runs": [{"value": "$notusing"}, {"text": "   ("}, {"value": "$notusing_pct", "decimals": 1, "suffix": "%"}, {"text": ")"}],
     "start": 3.0, "dur": 1.0},

    {"id": "fleet_line", "type": "line", "x": 540, "y": 1402, "align": "center", "font": "body", "size": 34, "color": "text",
     "runs": [{"text": "$fleet_prefix"}, {"value": "$fleet"}, {"text": "$fleet_suffix"}], "start": 4.4, "dur": 1.0},
    {"id": "bar", "type": "bar", "x": 100, "y": 1432, "w": 880, "h": 56, "border": 3, "gap": 3, "gap_color": "border",
     "track": "bg", "track_dur": 0.2,
     "segments": [{"value": "$bar_using", "color": "marker"}, {"value": "$bar_notusing", "color": "blue"},
                  {"value": "$bar_notcapable", "color": "notcap"}],
     "start": 4.6, "dur": 1.6},
    {"id": "bar_legend", "type": "line", "x": 540, "y": 1548, "align": "center", "font": "body", "size": 27, "color": "text",
     "runs": [{"swatch": "marker", "size": 20, "gap": 10, "radius": 0}, {"text": "$bar_using_label"},
              {"value": "$bar_using", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 0}, {"text": "    "},
              {"swatch": "blue", "size": 20, "gap": 10, "radius": 0}, {"text": "$bar_notusing_label"},
              {"value": "$bar_notusing", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 1}, {"text": "    "},
              {"swatch": "notcap", "size": 20, "gap": 10, "radius": 0, "border": 2}, {"text": "$bar_notcapable_label"},
              {"value": "$bar_notcapable", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 2}],
     "start": 4.6},
    {"id": "distance", "type": "line", "x": 540, "y": 1640, "align": "center", "font": "body_bold", "size": 38, "color": "text",
     "runs": [{"text": "$distance_label"}, {"value": "$distance", "font": "kinetic", "size": 56}, {"text": "$distance_unit"}],
     "start": 6.0, "dur": 1.2},

    {"id": "source", "type": "text", "role": "source", "text": "$source",
     "x": 540, "y": 1722, "anchor": "ms", "wrap_width": 900, "break_at": " · ", "start": 7.0},
    {"id": "credit", "type": "text", "role": "source", "text": "$credit", "x": 540, "y": 1830, "anchor": "ms", "start": 7.1}
  ]
}
