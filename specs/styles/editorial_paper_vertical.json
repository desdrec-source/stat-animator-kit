{
  "data_file": "../example_data.json",
  "theme": "editorial_paper",
  "canvas": {"width": 1080, "height": 1920, "fps": 30, "hold": 2.0},
  "elements": [
    {"id": "top_rule", "type": "rule", "x0": 80, "x1": 1000, "y0": 118, "width": 6, "color": "text", "start": 0.0, "draw_dur": 0.8},
    {"id": "kicker", "type": "text", "text": "$donut_label", "font": "body_bold", "size": 28, "color": "accent", "case": "upper",
     "x": 80, "y": 182, "anchor": "ls", "start": 0.3},
    {"id": "title", "type": "text", "role": "headline", "text": "$title", "size": 96,
     "x": 80, "y": 300, "anchor": "ls", "wrap_width": 920, "max_lines": 2, "balance": true, "start": 0.4},
    {"id": "subtitle", "type": "text", "role": "body", "text": "$subtitle", "size": 36,
     "x": 80, "y": 478, "anchor": "ls", "wrap_width": 920, "balance": true, "start": 0.7},

    {"id": "hero", "type": "line", "x": 80, "y": 800, "font": "headline", "size": 190, "color": "highlight",
     "runs": [{"value": "$donut_pct", "decimals": 1, "suffix": "%"}], "start": 1.2, "dur": 2.0},
    {"id": "hero_label", "type": "text", "text": "$donut_label", "font": "body_medium", "size": 30, "color": "muted",
     "x": 84, "y": 858, "anchor": "ls", "start": 1.4},
    {"id": "r_using_lbl", "type": "text", "text": "$using_label", "font": "body", "size": 30, "color": "muted",
     "x": 640, "y": 660, "anchor": "ls", "start": 1.5},
    {"id": "r_using", "type": "line", "x": 640, "y": 722, "font": "number", "size": 54, "color": "text",
     "runs": [{"value": "$using"}], "start": 1.5, "dur": 1.8},
    {"id": "r_cap_lbl", "type": "text", "text": "$capable_label", "font": "body", "size": 30, "color": "muted",
     "x": 640, "y": 790, "anchor": "ls", "start": 1.7},
    {"id": "r_cap", "type": "line", "x": 640, "y": 852, "font": "number", "size": 54, "color": "text",
     "runs": [{"value": "$capable"}], "start": 1.7, "dur": 1.8},
    {"id": "sep_rule", "type": "rule", "x0": 80, "x1": 1000, "y0": 930, "width": 2, "color": "grid", "start": 2.0, "draw_dur": 0.8},

    {"id": "b1_lbl", "type": "text", "text": "$capable_label", "role": "label", "size": 30, "x": 80, "y": 1010, "anchor": "ls", "start": 2.6},
    {"id": "b1_val", "type": "line", "x": 1000, "y": 1010, "align": "right", "font": "number", "size": 30, "color": "text",
     "runs": [{"value": "$capable", "sync": "b1"}], "start": 2.6},
    {"id": "b1", "type": "bar", "x": 80, "y": 1030, "w": 920, "h": 44, "track": "track", "total": "$capable",
     "segments": [{"value": "$capable", "color": "accent_light"}], "start": 2.6, "dur": 1.6},
    {"id": "b2_lbl", "type": "text", "text": "$notusing_label", "role": "label", "size": 30, "x": 80, "y": 1130, "anchor": "ls", "start": 2.7},
    {"id": "b2_val", "type": "line", "x": 1000, "y": 1130, "align": "right", "font": "number", "size": 30, "color": "text",
     "runs": [{"value": "$notusing", "sync": "b2"}, {"text": "  ("}, {"value": "$notusing_pct", "decimals": 1, "suffix": "%", "sync": "b2"}, {"text": ")"}],
     "start": 2.7},
    {"id": "b2", "type": "bar", "x": 80, "y": 1150, "w": 920, "h": 44, "track": "track", "total": "$capable",
     "segments": [{"value": "$notusing", "color": "accent"}], "start": 2.7, "dur": 1.6},
    {"id": "b3_lbl", "type": "text", "text": "$using_label", "role": "label", "size": 30, "x": 80, "y": 1250, "anchor": "ls",
     "color": "highlight", "start": 3.0},
    {"id": "b3_val", "type": "line", "x": 1000, "y": 1250, "align": "right", "font": "number", "size": 30, "color": "highlight",
     "runs": [{"value": "$using", "sync": "b3"}, {"text": "  ("}, {"value": "$using_pct", "decimals": 1, "suffix": "%", "sync": "b3"}, {"text": ")"}],
     "start": 3.0},
    {"id": "b3", "type": "bar", "x": 80, "y": 1270, "w": 920, "h": 44, "track": "track", "total": "$capable",
     "segments": [{"value": "$using", "color": "highlight"}], "start": 3.0, "dur": 1.6},

    {"id": "fleet_line", "type": "line", "x": 80, "y": 1420, "font": "body_medium", "size": 32, "color": "text",
     "runs": [{"text": "$fleet_prefix"}, {"value": "$fleet"}, {"text": "$fleet_suffix"}], "start": 4.3, "dur": 1.4},
    {"id": "grid", "type": "gridlines", "x": 80, "y": 1446, "w": 920, "h": 92, "ticks": [0, 25, 50, 75, 100], "suffix": "%",
     "color": "grid", "width": 2, "size": 22, "label_color": "dim", "label_dy": 30, "start": 4.4, "enter": "fade"},
    {"id": "bar", "type": "bar", "x": 80, "y": 1462, "w": 920, "h": 60, "track": "track", "track_opacity": 0.0, "gap": 3,
     "segments": [{"value": "$bar_using", "color": "highlight"}, {"value": "$bar_notusing", "color": "accent"},
                  {"value": "$bar_notcapable", "color": "notcap"}],
     "start": 4.5, "dur": 2.0},
    {"id": "bar_legend", "type": "line", "x": 80, "y": 1640, "font": "body", "size": 26, "color": "text",
     "runs": [{"swatch": "highlight", "size": 20, "gap": 10, "radius": 0}, {"text": "$bar_using_label"},
              {"value": "$bar_using", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 0}, {"text": "      "},
              {"swatch": "accent", "size": 20, "gap": 10, "radius": 0}, {"text": "$bar_notusing_label"},
              {"value": "$bar_notusing", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 1}, {"text": "      "},
              {"swatch": "notcap", "size": 20, "gap": 10, "radius": 0}, {"text": "$bar_notcapable_label"},
              {"value": "$bar_notcapable", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 2}],
     "start": 4.5, "enter": "fade"},
    {"id": "distance", "type": "line", "x": 80, "y": 1716, "font": "body_bold", "size": 34, "color": "text",
     "runs": [{"text": "$distance_label"}, {"value": "$distance"}, {"text": "$distance_unit"}], "start": 6.0, "dur": 1.6},

    {"id": "src_rule", "type": "rule", "x0": 80, "x1": 1000, "y0": 1752, "width": 1, "color": "grid", "start": 6.8, "draw_dur": 0.6},
    {"id": "source", "type": "text", "role": "source", "text": "$source",
     "x": 80, "y": 1792, "anchor": "ls", "wrap_width": 920, "break_at": " · ", "start": 7.0, "enter": "fade"},
    {"id": "credit", "type": "text", "role": "source", "text": "$credit",
     "x": 1000, "y": 1852, "anchor": "rs", "start": 7.1, "enter": "fade"}
  ]
}
