{
 "data_file": "../example_data.json",
 "theme": "dark_stat_card",
 "canvas": {
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "hold": 2.0
 },
 "background": {},
 "elements": [
  {
   "id": "title",
   "type": "text",
   "text": "$title",
   "font": "headline",
   "size": 138,
   "color": "highlight",
   "x": 960,
   "y": 142,
   "anchor": "ms",
   "max_width": 1800,
   "start": 0.0,
   "enter": "slide_up",
   "enter_dur": 0.8,
   "enter_offset": 40
  },
  {
   "id": "subtitle",
   "type": "text",
   "text": "$subtitle",
   "font": "body",
   "size": 34,
   "color": "sub",
   "x": 960,
   "y": 196,
   "anchor": "ms",
   "max_width": 1800,
   "start": 0.35,
   "enter": "slide_up",
   "enter_dur": 0.7
  },
  {
   "id": "donut",
   "type": "donut",
   "cx": 482,
   "cy": 552,
   "r": 262,
   "thickness": 84,
   "value": "$donut_pct",
   "color": "accent",
   "rest_color": "secondary",
   "start": 0.9,
   "dur": 2.6
  },
  {
   "id": "donut_pct",
   "type": "line",
   "x": 482,
   "y": 578,
   "align": "center",
   "font": "bold",
   "size": 108,
   "color": "accent",
   "runs": [
    {
     "value": "$donut_pct",
     "decimals": 1,
     "suffix": "%",
     "sync": "donut"
    }
   ],
   "start": 0.9,
   "enter_dur": 0.4
  },
  {
   "id": "donut_label",
   "type": "text",
   "text": "$donut_label",
   "font": "medium",
   "size": 38,
   "color": "text",
   "x": 482,
   "y": 640,
   "anchor": "ms",
   "start": 1.3,
   "enter": "slide_up",
   "enter_offset": 15
  },
  {
   "id": "capable_label",
   "type": "text",
   "text": "$capable_label",
   "font": "body",
   "size": 34,
   "color": "muted",
   "x": 962,
   "y": 290,
   "anchor": "ls",
   "start": 1.8,
   "enter": "slide_left"
  },
  {
   "id": "capable",
   "type": "line",
   "x": 962,
   "y": 372,
   "font": "black",
   "size": 84,
   "color": "text",
   "runs": [
    {
     "value": "$capable"
    }
   ],
   "start": 2.0,
   "dur": 2.0,
   "enter_dur": 0.4
  },
  {
   "id": "using_row",
   "type": "line",
   "x": 966,
   "y": 446,
   "font": "medium",
   "size": 42,
   "color": "text",
   "runs": [
    {
     "swatch": "accent",
     "size": 28,
     "gap": 16
    },
    {
     "text": "${using_label}  "
    },
    {
     "value": "$using"
    },
    {
     "text": " ("
    },
    {
     "value": "$using_pct",
     "decimals": 1,
     "suffix": "%"
    },
    {
     "text": ")"
    }
   ],
   "start": 2.5,
   "dur": 2.0,
   "enter": "slide_left"
  },
  {
   "id": "notusing_row",
   "type": "line",
   "x": 966,
   "y": 512,
   "font": "medium",
   "size": 42,
   "color": "text",
   "runs": [
    {
     "swatch": "secondary",
     "size": 28,
     "gap": 16
    },
    {
     "text": "${notusing_label}  "
    },
    {
     "value": "$notusing"
    },
    {
     "text": " ("
    },
    {
     "value": "$notusing_pct",
     "decimals": 1,
     "suffix": "%"
    },
    {
     "text": ")"
    }
   ],
   "start": 2.8,
   "dur": 2.0,
   "enter": "slide_left"
  },
  {
   "id": "fleet_line",
   "type": "line",
   "x": 962,
   "y": 638,
   "font": "body",
   "size": 32,
   "color": "muted",
   "runs": [
    {
     "text": "$fleet_prefix"
    },
    {
     "value": "$fleet"
    },
    {
     "text": "$fleet_suffix"
    }
   ],
   "start": 3.8,
   "dur": 1.6
  },
  {
   "id": "bar",
   "type": "bar",
   "x": 962,
   "y": 668,
   "w": 862,
   "h": 88,
   "radius": 4,
   "track": "track",
   "gap": 3,
   "segments": [
    {
     "value": "$bar_using",
     "color": "accent"
    },
    {
     "value": "$bar_notusing",
     "color": "secondary"
    },
    {
     "value": "$bar_notcapable",
     "color": "notcap"
    }
   ],
   "start": 4.2,
   "dur": 2.2
  },
  {
   "id": "bar_legend",
   "type": "line",
   "x": 962,
   "y": 808,
   "font": "body",
   "size": 25,
   "color": "dim",
   "runs": [
    {
     "text": "$bar_using_label"
    },
    {
     "value": "$bar_using",
     "decimals": 1,
     "suffix": "%",
     "sync": "bar",
     "seg": 0
    },
    {
     "text": "   \u00b7   ${bar_notusing_label}"
    },
    {
     "value": "$bar_notusing",
     "decimals": 1,
     "suffix": "%",
     "sync": "bar",
     "seg": 1
    },
    {
     "text": "   \u00b7   ${bar_notcapable_label}"
    },
    {
     "value": "$bar_notcapable",
     "decimals": 1,
     "suffix": "%",
     "sync": "bar",
     "seg": 2
    }
   ],
   "start": 4.2,
   "enter_dur": 0.5
  },
  {
   "id": "distance",
   "type": "line",
   "x": 962,
   "y": 880,
   "font": "semibold",
   "size": 42,
   "color": "highlight",
   "runs": [
    {
     "text": "$distance_label"
    },
    {
     "value": "$distance"
    },
    {
     "text": "$distance_unit"
    }
   ],
   "start": 5.5,
   "dur": 2.0,
   "enter": "slide_up",
   "enter_offset": 20
  },
  {
   "id": "source",
   "type": "text",
   "text": "$source",
   "font": "body",
   "size": 22,
   "color": "dim",
   "x": 960,
   "y": 1004,
   "anchor": "ms",
   "max_width": 1840,
   "start": 6.9,
   "enter_dur": 0.8
  },
  {
   "id": "credit",
   "type": "text",
   "text": "$credit",
   "font": "body",
   "size": 22,
   "color": "dim",
   "x": 960,
   "y": 1048,
   "anchor": "ms",
   "start": 7.1,
   "enter_dur": 0.8
  }
 ]
}