{
  "data_file": "../example_data.json",
  "theme": "terminal_market_desk",
  "canvas": {"width": 1080, "height": 1920, "fps": 30, "hold": 2.0},
  "elements": [
    {"id": "title", "type": "text", "role": "headline", "text": "$title", "size": 84,
     "x": 60, "y": 170, "anchor": "ls", "max_width": 960, "start": 0.0, "enter": "wipe", "enter_dur": 0.45, "ease_enter": "linear"},
    {"id": "title_rule", "type": "rule", "x0": 60, "x1": 1020, "y0": 205, "width": 3, "color": "up", "start": 0.2,
     "draw_dur": 0.5, "ease": "linear"},
    {"id": "subtitle", "type": "text", "role": "body", "text": "$subtitle", "size": 28,
     "x": 60, "y": 262, "anchor": "ls", "wrap_width": 960, "balance": true, "start": 0.5},

    {"id": "kpi_panel", "type": "panel", "x": 60, "y": 360, "w": 960, "h": 400, "fill": "surface", "start": 0.7},
    {"id": "kpi_tag", "type": "text", "role": "label", "text": "> ${donut_label}", "size": 28,
     "x": 96, "y": 420, "anchor": "ls", "start": 0.8},
    {"id": "kpi", "type": "line", "x": 90, "y": 620, "font": "mono_bold", "size": 190, "color": "up",
     "runs": [{"value": "$donut_pct", "decimals": 1, "suffix": "%", "flash": true, "sync": "kpi_bar", "seg": 0}],
     "start": 0.9},
    {"id": "kpi_bar", "type": "bar", "x": 96, "y": 664, "w": 888, "h": 28, "gap": 2, "track": "track", "track_dur": 0.1,
     "ease": "out_quad", "segments": [{"value": "$using_pct", "color": "up"}, {"value": "$notusing_pct", "color": "down"}],
     "start": 0.9, "dur": 0.9},
    {"id": "kpi_legend", "type": "line", "x": 96, "y": 730, "font": "mono", "size": 24, "color": "muted",
     "runs": [{"text": "${using_label} "}, {"value": "$using_pct", "decimals": 1, "suffix": "%", "color": "up", "sync": "kpi_bar", "seg": 0},
              {"text": "   ${notusing_label} "}, {"value": "$notusing_pct", "decimals": 1, "suffix": "%", "color": "down", "sync": "kpi_bar", "seg": 1}],
     "start": 0.9},

    {"id": "tbl_panel", "type": "panel", "x": 60, "y": 800, "w": 960, "h": 480, "fill": "surface", "start": 1.9},
    {"id": "th_l", "type": "text", "text": "METRIC", "font": "mono_medium", "size": 22, "color": "label", "x": 96, "y": 852, "anchor": "ls", "start": 2.0},
    {"id": "th_r", "type": "text", "text": "VALUE", "font": "mono_medium", "size": 22, "color": "label", "x": 984, "y": 852, "anchor": "rs", "start": 2.0},
    {"id": "th_rule", "type": "rule", "x0": 96, "x1": 984, "y0": 874, "width": 1, "color": "border", "start": 2.0, "draw_dur": 0.3, "ease": "linear"},

    {"id": "r1_l", "type": "text", "text": "$capable_label", "font": "mono", "size": 30, "color": "text", "x": 96, "y": 950, "anchor": "ls", "start": 2.1},
    {"id": "r1_v", "type": "line", "x": 984, "y": 950, "align": "right", "font": "mono_bold", "size": 40, "color": "text",
     "runs": [{"value": "$capable", "flash": {"color": "text", "text_color": "bg", "dur": 0.15}}], "start": 2.1, "dur": 0.6},
    {"id": "r1_rule", "type": "rule", "x0": 96, "x1": 984, "y0": 990, "width": 1, "color": "border", "start": 2.1, "draw_dur": 0.3, "ease": "linear"},

    {"id": "r2_l", "type": "text", "text": "$using_label", "font": "mono", "size": 30, "color": "text", "x": 96, "y": 1060, "anchor": "ls", "start": 2.3},
    {"id": "r2_v", "type": "line", "x": 984, "y": 1060, "align": "right", "font": "mono_bold", "size": 40, "color": "up",
     "runs": [{"value": "$using", "flash": true}, {"text": "  "}, {"value": "$using_pct", "decimals": 1, "suffix": "%", "size": 30, "font": "mono"}],
     "start": 2.3, "dur": 0.6},
    {"id": "r2_rule", "type": "rule", "x0": 96, "x1": 984, "y0": 1100, "width": 1, "color": "border", "start": 2.3, "draw_dur": 0.3, "ease": "linear"},

    {"id": "r3_l", "type": "text", "text": "$notusing_label", "font": "mono", "size": 30, "color": "text", "x": 96, "y": 1170, "anchor": "ls", "start": 2.5},
    {"id": "r3_v", "type": "line", "x": 984, "y": 1170, "align": "right", "font": "mono_bold", "size": 40, "color": "down",
     "runs": [{"value": "$notusing", "flash": {"color": "down", "text_color": "bg", "dur": 0.15}}, {"text": "  "},
              {"value": "$notusing_pct", "decimals": 1, "suffix": "%", "size": 30, "font": "mono"}],
     "start": 2.5, "dur": 0.6},
    {"id": "r3_rule", "type": "rule", "x0": 96, "x1": 984, "y0": 1210, "width": 1, "color": "border", "start": 2.5, "draw_dur": 0.3, "ease": "linear"},
    {"id": "r4", "type": "line", "x": 96, "y": 1255, "font": "mono", "size": 24, "color": "muted",
     "runs": [{"text": "$fleet_prefix"}, {"value": "$fleet"}, {"text": "$fleet_suffix"}], "start": 2.7, "dur": 0.6},

    {"id": "mix_tag", "type": "text", "role": "label", "text": "> ${bar_using_label}/ ${bar_notusing_label}/ ${bar_notcapable_label}", "size": 24,
     "x": 60, "y": 1350, "anchor": "ls", "max_width": 960, "start": 3.3},
    {"id": "bar", "type": "bar", "x": 60, "y": 1376, "w": 960, "h": 60, "gap": 3, "track": "track", "track_dur": 0.15,
     "segments": [{"value": "$bar_using", "color": "up"}, {"value": "$bar_notusing", "color": "down"},
                  {"value": "$bar_notcapable", "color": "notcap"}],
     "start": 3.4, "dur": 1.2},
    {"id": "bar_legend", "type": "line", "x": 60, "y": 1490, "font": "mono", "size": 25, "color": "text",
     "runs": [{"swatch": "up", "size": 18, "gap": 10, "radius": 0}, {"text": "$bar_using_label"},
              {"value": "$bar_using", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 0}, {"text": "   "},
              {"swatch": "down", "size": 18, "gap": 10, "radius": 0}, {"text": "$bar_notusing_label"},
              {"value": "$bar_notusing", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 1}, {"text": "   "},
              {"swatch": "notcap", "size": 18, "gap": 10, "radius": 0}, {"text": "$bar_notcapable_label"},
              {"value": "$bar_notcapable", "decimals": 1, "suffix": "%", "sync": "bar", "seg": 2}],
     "start": 3.4},

    {"id": "dist_panel", "type": "panel", "x": 60, "y": 1540, "w": 960, "h": 110, "fill": "surface", "start": 4.6},
    {"id": "dist_l", "type": "text", "text": "$distance_label", "font": "mono", "size": 28, "color": "text", "x": 96, "y": 1606, "anchor": "ls", "start": 4.7},
    {"id": "dist_v", "type": "line", "x": 984, "y": 1608, "align": "right", "font": "mono_bold", "size": 40, "color": "up",
     "runs": [{"value": "$distance", "flash": true}, {"text": "$distance_unit", "size": 28, "font": "mono", "color": "muted"}],
     "start": 4.7, "dur": 0.9},

    {"id": "source", "type": "text", "role": "source", "text": "$source",
     "x": 60, "y": 1730, "anchor": "ls", "wrap_width": 960, "break_at": " · ", "start": 5.8},
    {"id": "credit", "type": "text", "role": "source", "text": "$credit", "x": 1020, "y": 1850, "anchor": "rs", "start": 5.9}
  ]
}
