{
 "data_file": "../example_data.json",
 "theme": "dark_stat_card",
 "canvas": {
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "hold": 2.0
 },
 "background": {},
 "elements": [
  {
   "id": "title",
   "type": "text",
   "role": "headline",
   "text": "$title",
   "size": 168,
   "x": 540,
   "y": 200,
   "anchor": "ms",
   "wrap_width": 1000,
   "max_lines": 2,
   "balance": true,
   "start": 0.0,
   "enter": "slide_up",
   "enter_dur": 0.8,
   "enter_offset": 40
  },
  {
   "id": "subtitle",
   "type": "text",
   "role": "body",
   "text": "$subtitle",
   "size": 38,
   "x": 540,
   "y": 430,
   "anchor": "ms",
   "wrap_width": 960,
   "balance": true,
   "start": 0.35,
   "enter": "slide_up",
   "enter_dur": 0.7
  },
  {
   "id": "donut",
   "type": "donut",
   "cx": 540,
   "cy": 790,
   "r": 260,
   "thickness": 84,
   "value": "$donut_pct",
   "color": "accent",
   "rest_color": "secondary",
   "start": 0.9,
   "dur": 2.6
  },
  {
   "id": "donut_pct",
   "type": "line",
   "x": 540,
   "y": 816,
   "align": "center",
   "font": "bold",
   "size": 112,
   "color": "accent",
   "runs": [
    {
     "value": "$donut_pct",
     "decimals": 1,
     "suffix": "%",
     "sync": "donut"
    }
   ],
   "start": 0.9,
   "enter_dur": 0.4
  },
  {
   "id": "donut_label",
   "type": "text",
   "text": "$donut_label",
   "font": "medium",
   "size": 40,
   "color": "text",
   "x": 540,
   "y": 880,
   "anchor": "ms",
   "start": 1.3,
   "enter": "slide_up",
   "enter_offset": 15
  },
  {
   "id": "capable_label",
   "type": "text",
   "role": "label",
   "text": "$capable_label",
   "size": 38,
   "x": 540,
   "y": 1120,
   "anchor": "ms",
   "start": 1.8,
   "enter": "slide_up"
  },
  {
   "id": "capable",
   "type": "line",
   "x": 540,
   "y": 1218,
   "align": "center",
   "font": "black",
   "size": 104,
   "color": "text",
   "runs": [
    {
     "value": "$capable"
    }
   ],
   "start": 2.0,
   "dur": 2.0,
   "enter_dur": 0.4
  },
  {
   "id": "using_row",
   "type": "line",
   "x": 540,
   "y": 1298,
   "align": "center",
   "font": "medium",
   "size": 46,
   "color": "text",
   "runs": [
    {
     "swatch": "accent",
     "size": 30,
     "gap": 18
    },
    {
     "text": "${using_label}  "
    },
    {
     "value": "$using"
    },
    {
     "text": " ("
    },
    {
     "value": "$using_pct",
     "decimals": 1,
     "suffix": "%"
    },
    {
     "text": ")"
    }
   ],
   "start": 2.5,
   "dur": 2.0,
   "enter": "slide_up",
   "enter_offset": 20
  },
  {
   "id": "notusing_row",
   "type": "line",
   "x": 540,
   "y": 1368,
   "align": "center",
   "font": "medium",
   "size": 46,
   "color": "text",
   "runs": [
    {
     "swatch": "secondary",
     "size": 30,
     "gap": 18
    },
    {
     "text": "${notusing_label}  "
    },
    {
     "value": "$notusing"
    },
    {
     "text": " ("
    },
    {
     "value": "$notusing_pct",
     "decimals": 1,
     "suffix": "%"
    },
    {
     "text": ")"
    }
   ],
   "start": 2.8,
   "dur": 2.0,
   "enter": "slide_up",
   "enter_offset": 20
  },
  {
   "id": "fleet_line",
   "type": "line",
   "x": 540,
   "y": 1462,
   "align": "center",
   "font": "body",
   "size": 34,
   "color": "muted",
   "runs": [
    {
     "text": "$fleet_prefix"
    },
    {
     "value": "$fleet"
    },
    {
     "text": "$fleet_suffix"
    }
   ],
   "start": 3.8,
   "dur": 1.6
  },
  {
   "id": "bar",
   "type": "bar",
   "x": 70,
   "y": 1490,
   "w": 940,
   "h": 80,
   "radius": 4,
   "track": "track",
   "gap": 3,
   "segments": [
    {
     "value": "$bar_using",
     "color": "accent"
    },
    {
     "value": "$bar_notusing",
     "color": "secondary"
    },
    {
     "value": "$bar_notcapable",
     "color": "notcap"
    }
   ],
   "start": 4.2,
   "dur": 2.2
  },
  {
   "id": "bar_legend",
   "type": "line",
   "x": 540,
   "y": 1620,
   "align": "center",
   "font": "body",
   "size": 28,
   "color": "dim",
   "runs": [
    {
     "text": "$bar_using_label"
    },
    {
     "value": "$bar_using",
     "decimals": 1,
     "suffix": "%",
     "sync": "bar",
     "seg": 0
    },
    {
     "text": "   \u00b7   ${bar_notusing_label}"
    },
    {
     "value": "$bar_notusing",
     "decimals": 1,
     "suffix": "%",
     "sync": "bar",
     "seg": 1
    },
    {
     "text": "   \u00b7   ${bar_notcapable_label}"
    },
    {
     "value": "$bar_notcapable",
     "decimals": 1,
     "suffix": "%",
     "sync": "bar",
     "seg": 2
    }
   ],
   "start": 4.2,
   "enter_dur": 0.5
  },
  {
   "id": "distance",
   "type": "line",
   "x": 540,
   "y": 1700,
   "align": "center",
   "font": "semibold",
   "size": 46,
   "color": "highlight",
   "runs": [
    {
     "text": "$distance_label"
    },
    {
     "value": "$distance"
    },
    {
     "text": "$distance_unit"
    }
   ],
   "start": 5.5,
   "dur": 2.0,
   "enter": "slide_up",
   "enter_offset": 20
  },
  {
   "id": "source",
   "type": "text",
   "role": "source",
   "text": "$source",
   "x": 540,
   "y": 1770,
   "anchor": "ms",
   "wrap_width": 980,
   "break_at": " \u00b7 ",
   "start": 6.9,
   "enter_dur": 0.8
  },
  {
   "id": "credit",
   "type": "text",
   "role": "source",
   "text": "$credit",
   "x": 540,
   "y": 1878,
   "anchor": "ms",
   "start": 7.1,
   "enter_dur": 0.8
  }
 ]
}